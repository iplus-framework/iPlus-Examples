<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(DefaultNetCoreTargetFramework)</TargetFramework>
		<OutputType>Library</OutputType>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<IPlusIncludeDir>..\..\..\iPlus\bin\Debug\$(DefaultNetCoreTargetFramework)</IPlusIncludeDir>
		<OutputPath>$(SolutionDir)bin\$(Configuration)</OutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<IPlusIncludeDir>..\..\..\iPlus\bin\Release\$(DefaultNetCoreTargetFramework)</IPlusIncludeDir>
		<OutputPath>$(SolutionDir)bin\$(Configuration)</OutputPath>
	</PropertyGroup>
		<ItemGroup Condition="'$(UseIPlusPackages)' == 'true'">
			<PackageReference Include="iPlus.gip.core.autocomponent" />
			<PackageReference Include="iPlus.gip.core.datamodel" />
			<PackageReference Include="iPlus.gip.core.reporthandler" />
		</ItemGroup>
		<ItemGroup Condition="'$(UseIPlusPackages)' != 'true'">
		<Reference Include="gip.core.autocomponent">
			<HintPath>$(IPlusIncludeDir)\gip.core.autocomponent.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.datamodel">
			<HintPath>$(IPlusIncludeDir)\gip.core.datamodel.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.reporthandler">
			<HintPath>$(IPlusIncludeDir)\gip.core.reporthandler.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\mycompany.package.datamodel\mycompany.package.datamodel.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="VBControlScripts\" />
	</ItemGroup>
	<ItemGroup>
		<None Update="VBControlScripts\2024-11-01 13-35_developername.zip">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>