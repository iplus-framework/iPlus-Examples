<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<SolutionDir Condition="'$(SolutionDir)' == '' OR '$(SolutionDir)' == '*Undefined*'">$(MSBuildProjectDirectory)/../</SolutionDir>
		<TargetFramework>$(UITargetFramework)</TargetFramework>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' != 'Windows_NT'">win-x64</RuntimeIdentifier>
		<OutputType>WinExe</OutputType>
		<SccProjectName>SAK</SccProjectName>
		<SccLocalPath>SAK</SccLocalPath>
		<SccAuxPath>SAK</SccAuxPath>
		<SccProvider>SAK</SccProvider>
		<IsWebBootstrapper>true</IsWebBootstrapper>
		<PublishUrl>https://iplus-framework.com/</PublishUrl>
		<Install>true</Install>
		<InstallFrom>Web</InstallFrom>
		<UpdateEnabled>true</UpdateEnabled>
		<UpdateMode>Foreground</UpdateMode>
		<UpdateInterval>7</UpdateInterval>
		<UpdateIntervalUnits>Days</UpdateIntervalUnits>
		<UpdatePeriodically>false</UpdatePeriodically>
		<UpdateRequired>false</UpdateRequired>
		<MapFileExtensions>true</MapFileExtensions>
		<ApplicationRevision>0</ApplicationRevision>
		<ApplicationVersion>1.0.0.%2a</ApplicationVersion>
		<UseApplicationTrust>false</UseApplicationTrust>
		<BootstrapperEnabled>true</BootstrapperEnabled>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
	</PropertyGroup>
	<PropertyGroup>
		<BaseOutputPath>$(SolutionDir)bin\</BaseOutputPath>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<Title>iplus-framework WPF App</Title>
		<Description>WPF Program to start iplus-framework</Description>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageTags>iplus-framework</PackageTags>
		<PackageProjectUrl>https://github.com/iplus-framework</PackageProjectUrl>
		<RepositoryUrl>https://github.com/iplus-framework/iPlus.git</RepositoryUrl>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
	</PropertyGroup>
	<ItemGroup>
		<None Update="readme.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Resource Include="Images\Login.png" />
	</ItemGroup>
	<ItemGroup>
		<Resource Include="Images\iPlusIconDesktop.ico" />
	</ItemGroup>
	<ItemGroup>
		<Page Remove="Resources\Connection.xaml" />
		<Page Remove="Resources\DesignerItem.xaml" />
		<Page Remove="Resources\Resources\Button.xaml" />
		<Page Remove="Resources\Resources\Masterpage.xaml" />
		<Page Remove="Resources\Resources\Menu.xaml" />
		<Page Remove="Resources\Resources\Shared.xaml" />
		<Page Remove="Resources\Resources\TabControl.xaml" />
		<Page Remove="Resources\Resources\VBVisualGroup.xaml" />
		<Page Remove="Resources\Styles\Shared.xaml" />
		<Page Remove="Resources\VBResources.xaml" />
	</ItemGroup>
	<PropertyGroup>
		<ApplicationIcon>Images\iPlusIconDesktop.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<OutputPath>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\</OutputPath>
		<OutputPath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<NoWarn>CA1416;VSTHRD100;VSTHRD110;VSTHRD200;NU1510;VSTHRD001</NoWarn>
		<IPlusIncludeDir>..\..\..\iPlus\bin\Debug\$(UITargetFramework)</IPlusIncludeDir>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<OutputPath>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\</OutputPath>
		<OutputPath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</OutputPath>
		<OutDir>$(OutputPath)</OutDir>
		<NoWarn>CA1416;VSTHRD100;VSTHRD110;VSTHRD200;NU1510;VSTHRD001</NoWarn>
		<IPlusIncludeDir>..\..\..\iPlus\bin\Release\$(UITargetFramework)</IPlusIncludeDir>
	</PropertyGroup>
	<ItemGroup>
		<None Update="ConnectionStrings.config">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<SubType>Designer</SubType>
		</None>
		<AppDesigner Include="Properties\" />
		<None Update="VBXMLEditorSchemas\VBDesignEditor.xsd">
			<SubType>Designer</SubType>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="VBXMLEditorSchemas\VBReportEditor.xsd">
			<SubType>Designer</SubType>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup Condition="'$(UseIPlusPackages)' == 'true'">
		<PackageReference Include="iPlus.gip.core.autocomponent" />
		<PackageReference Include="iPlus.gip.core.datamodel" />
		<PackageReference Include="iPlus.gip.core.reporthandler" />
		<PackageReference Include="iPlus.gip.core.layoutengine" />
		<PackageReference Include="iPlus.gip.core.wpfservices" />
		<PackageReference Include="iPlus.gip.bso.iplus" />
		<PackageReference Include="iPlus.gip.core.communication" />
		<PackageReference Include="iPlus.gip.core.archiver" />
		<PackageReference Include="iPlus.gip.core.ControlScriptSync" />
		<PackageReference Include="iPlus.gip.core.dbsyncer" />
		<PackageReference Include="iPlus.gip.core.processapplication" />
		<PackageReference Include="iPlus.gip.core.manager" />
		<PackageReference Include="iPlus.gip.core.reporthandlerwpf" />
		<PackageReference Include="iPlus.gip.core.visualcontrols" />
		<PackageReference Include="iPlus.gip.core.webservices" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseProjectReferences)' != 'true' and '$(UseIPlusPackages)' != 'true'">
		<Reference Include="gip.core.autocomponent">
			<HintPath>$(IPlusIncludeDir)\gip.core.autocomponent.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.datamodel">
			<HintPath>$(IPlusIncludeDir)\gip.core.datamodel.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.reporthandler">
			<SpecificVersion>False</SpecificVersion>
			<HintPath>$(IPlusIncludeDir)\gip.core.reporthandler.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.layoutengine">
			<HintPath>$(IPlusIncludeDir)\gip.core.layoutengine.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.wpfservices">
			<HintPath>$(IPlusIncludeDir)\gip.core.wpfservices.dll</HintPath>
		</Reference>
		<Reference Include="gip.bso.iplus">
			<HintPath>$(IPlusIncludeDir)\gip.bso.iplus.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.communication">
			<HintPath>$(IPlusIncludeDir)\gip.core.communication.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.archiver">
			<HintPath>$(IPlusIncludeDir)\gip.core.archiver.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.ControlScriptSync">
			<HintPath>$(IPlusIncludeDir)\gip.core.ControlScriptSync.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.dbsyncer">
			<HintPath>$(IPlusIncludeDir)\gip.core.dbsyncer.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.processapplication">
			<HintPath>$(IPlusIncludeDir)\gip.core.processapplication.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.manager">
			<HintPath>$(IPlusIncludeDir)\gip.core.manager.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.reporthandlerwpf">
			<HintPath>$(IPlusIncludeDir)\gip.core.reporthandlerwpf.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.visualcontrols">
			<HintPath>$(IPlusIncludeDir)\gip.core.visualcontrols.dll</HintPath>
		</Reference>
		<Reference Include="gip.core.webservices">
			<HintPath>$(IPlusIncludeDir)\gip.core.webservices.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
		<ProjectReference Include="..\..\..\iPlus\gip.core.reporthandlerwpf\gip.core.reporthandlerwpf.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.archiver\gip.core.archiver.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.autocomponent\gip.core.autocomponent.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.communication\gip.core.communication.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.ControlScriptSync\gip.core.ControlScriptSync.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.crypto\gip.core.crypto.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.datamodel\gip.core.datamodel.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.dbsyncer\gip.core.dbsyncer.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.layoutengine\gip.core.layoutengine.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.manager\gip.core.manager.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.processapplication\gip.core.processapplication.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.reporthandlerwpf\gip.core.reporthandlerwpf.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.scichart\gip.core.scichart.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.visualcontrols\gip.core.visualcontrols.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.webservices\gip.core.webservices.csproj" />
		<ProjectReference Include="..\..\..\iPlus\gip.core.wpfservices\gip.core.wpfservices.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="CoreWCF.Primitives" />
		<PackageReference Include="System.Drawing.Common" />
		<PackageReference Include="Microsoft.VisualStudio.Threading" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseEFCoreForkIPlus)' == 'False'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseEFCoreForkIPlus)' == 'True'">
		<PackageReference Include="iPlus.EntityFrameworkCore" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\mycompany.bso.erp\mycompany.bso.erp.csproj" />
		<ProjectReference Include="..\mycompany.package.datamodel\mycompany.package.datamodel.csproj" />
		<ProjectReference Include="..\mycompany.package.demo\mycompany.package.demo.csproj" />
		<ProjectReference Include="..\mycompany.package.proc\mycompany.package.proc.csproj" />
	</ItemGroup>

	<Target Name="CopyIPlusFiles" AfterTargets="Build">
		<Message Text="IPlusIncludeDir: $(IPlusIncludeDir)" Importance="high" />
		<Message Text="OutDir: $(OutDir)" Importance="high" />

		<Copy SourceFiles="$(IPlusIncludeDir)\MATRIX32.dll" DestinationFolder="$(OutDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" Condition="Exists('$(IPlusIncludeDir)\MATRIX32.dll')" />
		<Copy SourceFiles="$(IPlusIncludeDir)\MATRIX64.dll" DestinationFolder="$(OutDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" Condition="Exists('$(IPlusIncludeDir)\MATRIX64.dll')" />
		<Copy SourceFiles="$(IPlusIncludeDir)\matrix.ini" DestinationFolder="$(OutDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" Condition="Exists('$(IPlusIncludeDir)\matrix.ini')" />

		<Message Text="Checking for VBControlScripts at: $(IPlusIncludeDir)\VBControlScripts" Importance="high" />
		<CreateItem Include="$(IPlusIncludeDir)\VBControlScripts\*.*" Condition="'$(UseIPlusPackages)' != 'true' and Exists('$(IPlusIncludeDir)\VBControlScripts')">
			<Output TaskParameter="Include" ItemName="VBControlScripts" />
		</CreateItem>
		<Copy SourceFiles="@(VBControlScripts)" DestinationFolder="$(OutDir)VBControlScripts" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" Condition="'@(VBControlScripts)' != ''" />

		<Message Text="Checking for DbScripts at: $(IPlusIncludeDir)\DbScripts" Importance="high" />
		<CreateItem Include="$(IPlusIncludeDir)\DbScripts\**\*.*" Condition="'$(UseIPlusPackages)' != 'true' and Exists('$(IPlusIncludeDir)\DbScripts')">
			<Output TaskParameter="Include" ItemName="DbScriptsFiles" />
		</CreateItem>
		<Message Text="Found DbScripts files: @(DbScriptsFiles-&gt;Count())" Importance="high" Condition="'@(DbScriptsFiles)' != ''" />
		<Copy SourceFiles="@(DbScriptsFiles)" DestinationFolder="$(OutDir)DbScripts\%(RecursiveDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" Condition="'@(DbScriptsFiles)' != ''" />
		<Warning Text="DbScripts folder not found at: $(IPlusIncludeDir)\DbScripts" Condition="'$(UseIPlusPackages)' != 'true' and !Exists('$(IPlusIncludeDir)\DbScripts')" />
	</Target>
	<Target Name="CopyToNet7Windows" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
		<ItemGroup>
			<_CopyToUiFiles Include="$(SolutionDir)bin\$(Configuration)\$(DefaultNetCoreTargetFramework)\**\*.*"
							Exclude="$(SolutionDir)bin\$(Configuration)\$(DefaultNetCoreTargetFramework)\ConnectionStrings.config;$(SolutionDir)bin\$(Configuration)\$(DefaultNetCoreTargetFramework)\System.Composition.AttributedModel.dll;$(SolutionDir)bin\$(Configuration)\$(DefaultNetCoreTargetFramework)\System.Composition.Convention.dll;$(SolutionDir)bin\$(Configuration)\$(DefaultNetCoreTargetFramework)\System.Composition.Hosting.dll;$(SolutionDir)bin\$(Configuration)\$(DefaultNetCoreTargetFramework)\System.Composition.Runtime.dll;$(SolutionDir)bin\$(Configuration)\$(DefaultNetCoreTargetFramework)\System.Composition.TypedParts.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_CopyToUiFiles)"
			  DestinationFiles="@(_CopyToUiFiles->'$(SolutionDir)bin\$(Configuration)\$(UITargetFramework)\%(RecursiveDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true" />
	</Target>
	<Target Name="CopyToNet7Linux" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
		<Exec
			Command="cp -r --update=none &quot;$(SolutionDir)bin/$(Configuration)/$(DefaultNetCoreTargetFramework)/.&quot; &quot;$(OutDir)&quot;" />
		<Exec
			Command="cp -r &quot;$(SolutionDir)bin/$(Configuration)/$(DefaultNetCoreTargetFramework)/VBControlScripts&quot; &quot;$(OutDir)&quot;"
			Condition="Exists('$(SolutionDir)bin/$(Configuration)/$(DefaultNetCoreTargetFramework)/VBControlScripts')" />
		<Exec
			Command="cp -r &quot;$(SolutionDir)bin/$(Configuration)/$(DefaultNetCoreTargetFramework)/DbScripts&quot; &quot;$(OutDir)&quot;"
			Condition="Exists('$(SolutionDir)bin/$(Configuration)/$(DefaultNetCoreTargetFramework)/DbScripts')" />
		<Exec
			Command="cp --update=none &quot;$(SolutionDir)bin/$(Configuration)/$(UITargetFramework)/&quot;*.dll &quot;$(OutDir)&quot;"
			Condition="'$(RuntimeIdentifier)' != ''" />
		<Exec
			Command="cp -f &quot;$(ProjectDir)ConnectionStrings.config&quot; &quot;$(OutDir)ConnectionStrings.config&quot;"
			Condition="Exists('$(ProjectDir)ConnectionStrings.config')" />
	</Target>
</Project>