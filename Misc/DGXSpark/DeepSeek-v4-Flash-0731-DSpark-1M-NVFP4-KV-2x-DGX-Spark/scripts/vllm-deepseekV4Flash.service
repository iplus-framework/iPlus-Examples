[Unit]
Description=Dual-node DeepSeek-V4-Flash-0731 DSpark vLLM service (head orchestrator)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=oneshot
User=gipsoft
Group=gipsoft
WorkingDirectory=/home/gipsoft/github/DeepSeek-v4-Flash-0731-DSpark-1M-NVFP4-KV-2x-DGX-Spark/scripts
RemainAfterExit=yes

# Tunables for the launcher script
Environment="IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1-ray"
Environment="DSPARK_MODEL=Rarri/DeepSeek-V4-Flash-0731-NVFP4"
Environment="RAY_RUNTIME_INSTALL=0"
Environment="RARRI_NVFP4_TUNE_AUTO=1"
Environment="RARRI_ULTRA_SAFE_MODE=1"
Environment="AUTO_PROMOTE_SPECULATIVE_AFTER_READY=0"
Environment="FORCE_MHC_TORCH_FALLBACK=1"
Environment="FORCE_DISABLE_DEEP_GEMM_ON_INVALID_IMAGE=1"
Environment="FORCE_DISABLE_DEEP_GEMM_MQA_METADATA=1"
Environment="FORCE_DISABLE_DEEP_GEMM_SPARSE_INDEXER=1"
Environment="FORCE_DSPARK_WO_FALLBACK=1"
Environment="FORCE_DEEP_GEMM_SM121_COMPAT=1"
Environment="RARRI_FORCE_NVFP4_CLAMP_RELAX=1"
Environment="FORCE_NVFP4_CLAMP_BACKEND_RELAX=1"
Environment="MOE_BACKEND=flashinfer_cutlass"
Environment="MAX_MODEL_LEN=65536"
Environment="MAX_NUM_SEQS=1"
Environment="MAX_NUM_BATCHED_TOKENS=128"
Environment="MAX_PARALLEL_LOADING_WORKERS=1"
Environment="ENABLE_ASYNC_SCHEDULING=0"
Environment="ENABLE_SPECULATIVE_DECODE=0"
Environment="ENABLE_CHUNKED_PREFILL=1"
Environment="ENABLE_PREFIX_CACHING=0"
Environment="GPU_MEM_UTIL=0.45"
Environment="MTP_NUM_TOKENS=5"
Environment="KV_CACHE_MEMORY_BYTES=4000000000"
Environment="PIP_CACHE_HOST_DIR=/home/gipsoft/.cache/pip"

# Ensure SSH auth and remote docker are reachable before launch.
ExecStartPre=/usr/bin/ssh -o LogLevel=ERROR -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i /home/gipsoft/.ssh/id_ed25519_shared -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes -o ConnectTimeout=10 gipsoft@192.168.100.11 "sudo docker info >/dev/null"
ExecStart=/usr/bin/bash /home/gipsoft/github/DeepSeek-v4-Flash-0731-DSpark-1M-NVFP4-KV-2x-DGX-Spark/scripts/my-deepseekV4Flash-launch.sh
ExecStartPost=/usr/bin/curl --fail --silent --show-error --max-time 300 -H Content-Type:application/json -d '{"model":"deepseek-v4-flash-dspark","messages":[{"role":"user","content":"Reply with exactly OK."}],"max_tokens":1,"temperature":0.0,"stream":false}' http://127.0.0.1:8888/v1/chat/completions

# Stop both containers on both nodes using bounded-time cleanup.
ExecStop=-/usr/bin/env SSH_USER=gipsoft WORKER_IP=192.168.100.11 SSH_KEY=/home/gipsoft/.ssh/id_ed25519_shared STOP_TIMEOUT_SEC=8 REMOVE_TIMEOUT_SEC=8 /usr/bin/bash /home/gipsoft/github/DeepSeek-v4-Flash-0731-DSpark-1M-NVFP4-KV-2x-DGX-Spark/scripts/safe-stop-dspark.sh

Restart=on-failure
RestartSec=20
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
